; FF12 TZA RNG Tracker
; All offsets below are hexadecimal unless noted otherwise.

; FFXII TZA Switch Title ID
title_id=0x0100EB100AB42000

; RNG address mode:
;   main_pointer = rng_offset is a MAIN-relative pointer slot
;   main         = rng_offset is a MAIN-relative object address
;   heap         = rng_offset is a heap-relative object address
;   absolute     = rng_offset is an absolute object address
rng_base=main_pointer
; ARM64 pointer size used by the MAIN-relative pointer slot.
pointer_size=64

; Validated for Switch build C2932C4D1C84ED7D.
rng_offset=0x0178F1A0

; For main_pointer mode, these offsets follow the dereferenced pointer.
; State = 624 x uint32_t = 0x9C0 bytes.
state_offset=0x00000258
index_offset=0x00000C18

; Polling/preview settings.
poll_ms=100
preview_count=24

; Experimental: keep the mini window visible while returning controller
; input to the game. Exit with the Tesla key combo.
; Set to 0 to keep the mini window in normal foreground-overlay mode.
background_input=1

; Success rule shown by the overlay.
; The game-facing percentage view is (MT19937 output % 100).
; Inclusive [success_min, success_max].
; Example [0,0] = 1% theoretical window.
success_min=0
success_max=0
